# Express API configuration
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=defox

# Public origin of the Next.js app (CORS + post-install redirects)
WEB_APP_URL=http://localhost:3000

# Application session cookie (HTTP-only)
SESSION_COOKIE_NAME=defox_session
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=168

# GitHub App (https://github.com/settings/apps)
GITHUB_APP_ID=123456
GITHUB_APP_NAME=Cloud Agent
GITHUB_APP_SLUG=cloud-agent
GITHUB_CLIENT_ID=Iv1.0000000000000000
GITHUB_CLIENT_SECRET=replace-me
# Raw PEM, PEM with escaped \n, or base64 of the PEM
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Must match the GitHub App "Setup URL" / "Callback URL"
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback
# Required: the webhook endpoint is public, so deliveries must be verifiable.
# Use a random value of at least 16 characters in production; shorter existing
# secrets remain supported with a startup warning so webhook verification stays intact.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-string-of-at-least-16-chars

# Required: shared secret for the future agent/sandbox service (clone credentials)
INTERNAL_SERVICE_TOKEN=replace-with-a-random-string-of-at-least-16-chars

# E2B (server-side only)
E2B_API_KEY=replace-with-your-e2b-api-key
# Leave unset until the Task 4 custom template is built.
E2B_TEMPLATE=
E2B_IDLE_TIMEOUT_MS=1200000
E2B_HARD_TIMEOUT_MS=7200000

# Future model runtime (server-side only). Leave XAI_API_KEY unset until enabled.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini
XAI_STORE_RESPONSES=false

# Future artifact, preview, retention, telemetry, and runtime budgets (server-side only)
ARTIFACT_STORAGE_DRIVER=gridfs
ARTIFACT_MAX_ITEM_BYTES=52428800
ARTIFACT_MAX_RUN_BYTES=524288000
PREVIEW_MAX_PORTS=1
PREVIEW_ALLOWED_ORIGINS=
EVENT_RETENTION_DAYS=7
ARTIFACT_RETENTION_DAYS=30
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
AGENT_MAX_PARALLEL_TRACKS=3
AGENT_RUN_TIMEOUT_MS=5400000
AGENT_TURN_TIMEOUT_MS=600000
AGENT_MAX_TOOL_CALLS=200
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MAX_TOTAL_TOKENS=1000000
AGENT_MAX_CORRECTIONS=1
AGENT_MODEL_RETRIES=2
TOOL_COMMAND_TIMEOUT_MS=600000
TOOL_MAX_INLINE_BYTES=262144
TOOL_MAX_TEXT_FILE_BYTES=2097152
TOOL_MAX_DIFF_BYTES=1048576
BROWSER_MAX_ACTIONS=100
BROWSER_ACTION_TIMEOUT_MS=30000
APPROVAL_TTL_MS=1800000
RUN_USER_CONCURRENCY=2
RUN_GLOBAL_CONCURRENCY=20
